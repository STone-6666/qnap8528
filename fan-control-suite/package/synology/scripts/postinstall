#!/bin/sh
set -e
cp -r "$SYNOPKG_PKGDEST"/* /usr/local/fan-control-suite/ || true
if command -v systemctl >/dev/null 2>&1; then
  cp /usr/local/fan-control-suite/systemd/fan-control-daemon.service /etc/systemd/system/
  systemctl daemon-reload
  systemctl enable --now fan-control-daemon.service || true
fi
exit 0
